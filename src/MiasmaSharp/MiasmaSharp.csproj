<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MiasmaSharp</RootNamespace>
    <AssemblyName>MiasmaSharp</AssemblyName>
    <Version>0.1.0</Version>
    <Authors>Aiden A</Authors>
    <Description>Tears of the Kingdom's gloom (Miasma) renderer: areas, parameters, noise and shaders.</Description>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <BymlLibRoot Condition="'$(BymlLibRoot)' == ''">$(MSBuildThisFileDirectory)..\..\lib</BymlLibRoot>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Shaders\*.vert;Shaders\*.frag" LogicalName="MiasmaSharp.Shaders.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- The renderer's parameters and the volumes' shapes are BYML documents. -->
    <ProjectReference Include="$(BymlLibRoot)\BymlSharp\src\BymlSharp\BymlSharp.csproj" />
  </ItemGroup>

</Project>
